// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String
  listings         Listing[]
  roles            Role[]            @default([USER])
  createdAt        DateTime          @default(now())
  inspectorProfile InspectorProfile?

  buyerAppointments     Appointment[] @relation("AppointmentBuyer")
  sellerAppointments    Appointment[] @relation("AppointmentSeller")
  inspectorAppointments Appointment[] @relation("AppointmentInspector")
}

model InspectorProfile {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])
  bio             String
  specialties     Specialty[]
  city            String
  state           String
  serviceRadiusKm Int
  basePriceCents  Int
  verified        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum Role {
  USER
  INSPECTOR
  ADMIN
}

enum Specialty {
  ENGINE
  TRANSMISSION
  SUSPENSION
  BRAKES
  ELECTRICAL
  BODYWORK
  AIR_CONDITIONING
}

enum ListingStatus {
  ACTIVE
  SOLD
  PAUSED
  ARCHIVED // substitui a exclusão física; status final
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
}

model Listing {
  id           String          @id @default(uuid())
  sellerId     String
  seller       User            @relation(fields: [sellerId], references: [id])
  title        String
  description  String
  priceCents   Int
  city         String
  state        String
  status       ListingStatus   @default(ACTIVE)
  vehicle      VehicleDetails?
  appointments Appointment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([sellerId])
}

model VehicleDetails {
  id           String       @id @default(uuid())
  listingId    String       @unique
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  brand        String
  model        String
  year         Int
  mileageKm    Int
  fuel         FuelType
  transmission Transmission
}

enum AppointmentStatus {
  REQUESTED // comprador pediu
  ACCEPTED // avaliador aceitou; aguarda o vendedor
  AWAITING_PAYMENT // vendedor confirmou local e horário
  PAID // declarado (branch de pagamento)
  REPORT_SUBMITTED // declarado (branch de laudo)
  DISPUTED // declarado (branch de disputa)
  COMPLETED // declarado
  DECLINED // final: o avaliador recusou
  CANCELLED // final
  EXPIRED // final
}

enum AppointmentActor {
  BUYER
  SELLER
  INSPECTOR
  SYSTEM
}

/// Agendamento de avaliação. Desenho em docs/appointments-design.md.
/// ATENÇÃO: constraints fora do Prisma (exclusion constraint do horário do
/// avaliador, índice único parcial do trio em aberto e CHECKs) ficam no SQL
/// da migration add_appointments. Não as remova sem atualizar o desenho.
model Appointment {
  id                   String            @id @default(uuid())
  listingId            String
  listing              Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId              String
  buyer                User              @relation("AppointmentBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId             String // cópia de Listing.sellerId feita na criação
  seller               User              @relation("AppointmentSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  inspectorUserId      String // User.id do avaliador (não o id do perfil)
  inspector            User              @relation("AppointmentInspector", fields: [inspectorUserId], references: [id], onDelete: Restrict)
  status               AppointmentStatus @default(REQUESTED)
  startsAt             DateTime          @db.Timestamptz(3)
  endsAt               DateTime          @db.Timestamptz(3)
  expiresAt            DateTime?         @db.Timestamptz(3)
  meetingAddress       String? // preenchido pelo vendedor no confirm
  priceCents           Int // congelado = InspectorProfile.basePriceCents
  platformFeeBps       Int // congelado = PLATFORM_FEE_BPS
  platformFeeCents     Int
  inspectorPayoutCents Int
  acceptedAt           DateTime?         @db.Timestamptz(3)
  confirmedAt          DateTime?         @db.Timestamptz(3)
  endedAt              DateTime?         @db.Timestamptz(3)
  endedBy              AppointmentActor?
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([inspectorUserId, startsAt])
  @@index([listingId, status])
  @@index([status, expiresAt])
}
