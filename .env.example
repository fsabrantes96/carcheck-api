DATABASE_URL="postgresql://app:app@localhost:5432/carcheck"
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"
JWT_EXPIRES_IN_SECONDS=3600

# Regras de negócio (validadas no boot; a aplicação não sobe se estiverem erradas)
# Obrigatória: comissão da plataforma em pontos-base, inteiro de 0 a 10000 (1000 = 10%).
PLATFORM_FEE_BPS=1000
# Opcionais (valores padrão abaixo):
# Preço mínimo da avaliação, em centavos (5000 = R$ 50,00). Inteiro de 1 a 500000
# (o teto do preço base do avaliador); acima disso a aplicação não sobe.
MIN_INSPECTION_PRICE_CENTS=5000
# Duração fixa de cada avaliação, em minutos.
APPOINTMENT_DURATION_MINUTES=60
# Antecedência mínima para agendar, em horas (máximo de 60 dias à frente).
APPOINTMENT_MIN_NOTICE_HOURS=24

# Jobs agendados (cron), true ou false. Padrão true. Com false, o job que expira
# agendamentos vencidos não roda (os e2e usam false).
JOBS_ENABLED=true

# Opcional: banco dos testes e2e (npm run test:e2e). O padrão é
# postgresql://app:app@localhost:5432/carcheck_test. Nunca use o banco "carcheck".
# E2E_DATABASE_URL="postgresql://app:app@localhost:5432/carcheck_test"
